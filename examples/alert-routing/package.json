{
  "name": "alertrouter",
  "version": "0.0.0",
  "private": true,
  "description": "Alert routing decided by Sigil policies: a TypeScript service on @spechtlabs/sigil's WebAssembly engine",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run scripts/copy-wasm.ts && next dev",
    "build": "bun run scripts/copy-wasm.ts && next build && bun run scripts/assemble-standalone.ts",
    "start": "cd .next/standalone && node alertrouter.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "fmt": "biome check --write .",
    "export-kind": "bun run scripts/export-kind.ts",
    "embed": "bun run scripts/embed.ts",
    "generate": "bun run export-kind && bun run embed",
    "ui:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "postinstall": "bun run scripts/vendor-sigil.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@pyroscope/nodejs": "0.6.5",
    "@spechtlabs/sigil": "file:../../bindings/typescript",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "geist": "1.7.2",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prom-client": "15.1.3",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  }
}
