    {
      "id": 26,
      "type": "stat",
      "title": "Evaluations / second",
      "description": "Observed rate of completed p.Eval calls across access and deploy policies over the rate window. Includes successful and failed evaluations. A deployment can contribute two evaluations. Follows Team. This is achieved throughput at the current offered load.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: eval/s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "No evaluations"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum(rate(deploygate_access_evaluation_duration_seconds_count{job=\"deploygate\",team=~\"${team:regex}\"}[$__rate_interval])) + (sum(rate(deploygate_evaluation_duration_seconds_count{job=\"deploygate\",team=~\"${team:regex}\"}[$__rate_interval])) or vector(0))",
          "legendFormat": "Evaluations / second",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
