    {
      "id": 1,
      "type": "stat",
      "title": "Last successful reload",
      "description": "Seconds since the older of the team and access bundles last loaded, so a stuck bundle can't hide behind a fresh one. With polling on, it resets every time a policies directory changes; a failed reload leaves it growing while the previous bundle keeps serving.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "time() - min(deploygate_policy_last_reload_timestamp_seconds)",
          "legendFormat": "age",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ]
    },
