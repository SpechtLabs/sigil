{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "last-release-sha": "5eb10920a3c251adf02b4986138d4f1648e8ee19",
  "packages": {
    ".": {
      "release-type": "go",
      "package-name": "sigil",
      "include-component-in-tag": false,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "exclude-paths": [
        "docs",
        "examples"
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "bindings/typescript/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "editors/vscode/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "editors/tree-sitter-sigil/tree-sitter.json",
          "jsonpath": "$.metadata.version"
        },
        {
          "type": "generic",
          "path": "editors/tree-sitter-sigil/src/parser.c"
        },
        {
          "type": "toml",
          "path": "bindings/rust/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "bindings/rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='spechtlabs-sigil')].version"
        },
        {
          "type": "toml",
          "path": "examples/feature-flags/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='spechtlabs-sigil')].version"
        }
      ]
    }
  }
}
