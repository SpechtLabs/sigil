kind AccessGrant version 1

type Actor {
  name: string
  groups: list<string>
  clearance: string
}

input actor: Actor
input team: string
input environment: string

decision reader {
  reason: team_member | everyone_in_staging
}

decision deployer {
  reason: team_member | oncall
  ttl: duration = 8h
}

decision release_manager {
  reason: platform_member
  ttl: duration = 8h
}

decision admin {
  reason: clearance | break_glass
  ttl: duration = 1h
}

decision auditor {
  reason: compliance_member
}

collect all
exclusive admin, release_manager
