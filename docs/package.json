    "http-server": "^14.1.1",
    "markdown-it-container": "^4.0.0",
    "sass-embedded": "^1.105.1",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-plume": "1.0.0-rc.212"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
