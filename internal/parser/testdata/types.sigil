kind Shapes version 2

enum Tier: critical | standard | internal
enum Plan:
  free
  | pro |
  enterprise

type Nested {
  matrix: list<list<string>>
  lookup: map<string, list<int>>
  maybe: ?string
  deep: map<string, map<string, ?Nested>>
}

input nested: Nested
input flag: bool
input tiers: map<Tier, list<?Tier>>

fn keys(map<string, string>,) -> list<string>
fn now() -> timestamp
fn tier_of(string) -> Tier

decision allow {
  reason: none | ok
  weights: map<string, int> = {}
  tier: Tier = standard
  tags: list<string> = []
}

collect one
precedence allow
default allow(reason: none)

---

policy shapes.demo: Shapes@1

param m: map<string, int>= {}
param names: list<string>= ["a"]
param nested: list<list<string>> = [["a"], []]
param limit: int = -3
param timeout: duration = 1h + 30m
param tier: Tier = critical
param allowed: list<Tier> = [standard, internal]

when flag {
  allow(reason: ok, weights: m, tags: names,)
}
