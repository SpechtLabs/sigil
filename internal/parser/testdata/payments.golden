policy payments.production: DeployApproval@1 [1:1-19:2]
  use deploy.guardrails [3:1-3:22]
  use deploy.production [4:1-4:22]
  use deploy.common.{cleared} [5:1-5:28]
  guardrails(min_soak: 4h) [7:1-7:25]
  when (service.labels["compliance"] == "pci") { [9:1-11:2]
    production(approvers: ["payments-leads", "security-leads"]) [10:3-10:62]
  }
  when (service.labels["compliance"] != "pci") { [13:1-15:2]
    production(approvers: ["payments-leads"]) [14:3-14:44]
  }
  when (cleared and ("payments-sre" in actor.teams)) { [17:1-19:2]
    approve(payments_sre, bake: 15m) [18:3-18:35]
  }
