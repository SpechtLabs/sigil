kind AccessGrant version 1 [1:1-17:12]
  type Actor { [3:1-7:2]
    name: string
    groups: list<string>
    clearance: string
  }
  input actor: Actor [9:1-9:19]
  decision read(reason: string) [11:1-11:30]
  decision write(reason: string) [12:1-12:31]
  decision admin(reason: string, ttl: duration = 8h) [13:1-13:51]
  decision customer_data_writer(reason: string) [14:1-14:46]
  decision development_environment_writer(reason: string) [15:1-15:56]
  collect all [17:1-17:12]
---
policy access.guardrails: AccessGrant [21:1-30:54]
  assert("sod_customer_dev", ([customer_data_writer, development_environment_writer] exclusive in outcome)) [23:1-24:79]
  assert("pii_needs_clearance", ((customer_data_writer not in outcome) or (actor.clearance == "pii"))) [26:1-28:2]
  assert("no_root", (all g in actor.groups: (g != "root"))) [30:1-30:54]
---
policy access.platform: AccessGrant [34:1-44:2]
  use access.guardrails [36:1-36:22]
  guardrails() [38:1-38:13]
  when ("platform" in actor.groups) { [40:1-44:2]
    write("platform_member") [41:3-41:27]
    development_environment_writer("platform_member") [42:3-42:52]
    assert("actor_named", (actor.name != "")) [43:3-43:42]
  }
