kind Broken version 1

decision deny {
  reason: conflicting_rules | no_rule_matched
}

// A broken declaration before a conflict doesn't swallow it.
collect
conflict deny(reason: conflicting_rules)

conflit deny(reason: conflicting_rules)

conflict deny
default deny(reason: no_rule_matched)

conflict "conflicting_rules"

conflict(reason: conflicting_rules)

---

// `conflict` is reserved, so it can't name an input or a reason.
kind Reserved version 1

input conflict: bool

decision deny {
  reason: conflict | no_rule_matched
}
