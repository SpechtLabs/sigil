policy errors.rules: DeployApproval

param min_soak: duration = 24h

// A `use` after another statement.
use deploy.common.{cleared}

// `let` inside a body.
when cleared {
  let tmp = release.soak
  deny("tmp")
}

// A chained comparison; the statement is skipped, the next one isn't.
when release.soak < min_soak < 2h {
  deny("chain")
}

// An unclosed parenthesis.
when (release.hotfix or cleared {
  deny("paren")
}

// A bare name where a statement should be.
guardrails

// A second positional argument.
when cleared {
  review("owner", "extra", approvers: approvers)
}

// Everything after the errors still parses.
when cleared {
  approve("fine", bake: 15m)
}

// The separator glued into arithmetic. It ends the document, so this
// case comes last.
let tight = min_soak---1h
