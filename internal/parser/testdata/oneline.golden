policy single.line: DeployApproval [1:1-1:221]
  use deploy.common.{cleared} [1:36-1:63]
  let a = (environment == "production") [1:64-1:99]
  let b = ("deployer" in actor.roles) [1:100-1:133]
  guardrails(min_soak: 4h) [1:134-1:158]
  when (a and b) { [1:159-1:221]
    review("service_owner", approvers: approvers) [1:174-1:219]
  }
---
module single.more: DeployApproval [1:226-1:276]
  let x = cleared [1:261-1:276]
