policy single.line: DeployApproval [1:1-1:227]
  use deploy.common.{cleared} [1:36-1:63]
  let a = (environment == "production") [1:64-1:99]
  let b = ("deployer" in actor.roles) [1:100-1:133]
  guardrails(min_soak: 4h) [1:134-1:158]
  when (a and b) { [1:159-1:227]
    review(reason: service_owner, approvers: approvers) [1:174-1:225]
  }
---
module single.more: DeployApproval [1:232-1:282]
  let x = cleared [1:267-1:282]
