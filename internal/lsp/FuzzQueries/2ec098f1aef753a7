[]byte("// `conflict` is a keyword, like `default`. A type field may still be\n// spelled like it, as fields may be spelled like any keyword.\nkind Gate version 1\n\ntype Merge {\n  conflict: bool\n}\n\ninp{t merge: Merge\n\ndecision deny {\n  reason: conflicting_rules | no_rule_matched\n}\n\ndecision allow {\n  reason: owner\n  ttl: duration = 1h\n}\n\ncollect one\nprecedence deny > allow\n\ndefault deny(reason: no_rule_matched)\nconflict deny(reason: conflicting_rules)\n\n---\n\n// Joined onto one line, as a templater might, it still ends the line\n// before it and starts its own declaratkon.\nkind Joined version 1 decision allow { reason: owner ttl: duration = 1h } collect one precedence allow default allow(reason: owner) conflict allow(reason: owner, ttl: 0s)\n\n---\n\npolicy gate.main: Gate@1\n\nwhen merge.conflict {\n  deny(reason: conflicting_rules)\n}\n")
