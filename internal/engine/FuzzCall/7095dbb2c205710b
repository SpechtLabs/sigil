\\"groups\\\": [\\\"compliance\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/other-team-sre.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"linus\\\",\\n    \\\"groups\\\": [\\\"checkout-sre\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/outsider.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"grace\\\",\\n    \\\"groups\\\": [\\\"marketing\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/platform.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"margaret\\\",\\n    \\\"groups\\\": [\\\"platform\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/release-manager.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"margaret\\\",\\n    \\\"groups\\\": [\\\"payments\\\", \\\"platform\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/sre.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"linus\\\",\\n    \\\"groups\\\": [\\\"payments-sre\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/staging-outsider.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n   0\\\"name\\\": \\\"grace\\\",\\n    \\\"groups\\\": [\\\"marketing\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"staging\\\"\\n}\\n\"},{\"path\":\"access/testdata/team-member-staging.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"ada\\\",\\n    \\\"groups\\\": [\\\"payments\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"staging\\\"\\n}\\n\"},{\"path\":\"access/testdata/team-member.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"ada\\\",\\n    \\\"groups\\\": [\\\"payments\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/unnamed-actor.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"\\\",\\n    \\\"groups\\\": [\\\"payments\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"},{\"path\":\"access/testdata/unnamed-auditor-in-team.json\",\"source\":\"{\\n  \\\"actor\\\": {\\n    \\\"name\\\": \\\"\\\",\\n    \\\"groups\\\": [\\\"payments\\\", \\\"compliance\\\"],\\n    \\\"clearance\\\": \\\"standard\\\"\\n  },\\n  \\\"team\\\": \\\"payments\\\",\\n  \\\"environment\\\": \\\"production\\\"\\n}\\n\"}],\"files\":[{\"path\":\"access/main.sigil\",\"source\":\"policy access.main: AccessGrant@1\\n\\nuse access.guardrails\\nuse access.common.{admin_cleared, break_glass, compliance_member, on_call, platform_member, team_member}\\n\\nguardrails()\\n\\nwhen team_member {\\n  reader(reason: team_member)\\n  deployer(reason: team_member)\\n}\\n\\nwhen environment == \\\"staging\\\" {\\n  reader(reason: everyone_in_staging)\\n}\\n\\n// The on-call SRE deploys for two hours, long enough to ship a fix.\\nwhen on_call {\\n  deployer(reason: oncall, ttl: 2h)\\n}\\n\\n// An admin already holds everything a release manager does, and the kind\\n// declares the two exclusive, so the platform grant leaves admins out.\\nwhen platform_member and not admin_cleared {\\n  release_manager(reason: platform_member, ttl: 4h)\\n}\\n\\nwhen admin_cleared {\\n  admin(reason: clearance)\\n}\\n\\n// Break-glass access is short-lived by design. It doesn't check for platform\\n// membership: a break-glass member in platform is a conflict the host reports,\\n// because the two groups aren't meant to overlap.\\nwhen break_glass {\\n  admin(reason: break_glass, ttl: 15m)\\n}\\n\\nwhen compliance_member {\\n  auditor(reason: compliance_member)\\n}\\n\"},{\"path\":\"access_grant.sigil\",\"source\":\"kind AccessGrant version 1\\n\\ntype Actor {\\n  name: string\\n  groups: list\\u003cstring\\u003e\\n  clearance: string\\n}\\n\\ninput actor: Actor\\ninput team: string\\ninput environment: string\\n\\ndecision reader {\\n  reason: team_member | everyone_in_staging\\n}\\n\\ndecision deployer {\\n  reason: team_member | oncall\\n  ttl: duration = 8h\\n}\\n\\ndecision release_manager {\\n  reason: platform_member\\n  ttl: duration = 8h\\n}\\n\\ndecision admin {\\n  reason: clearance | break_glass\\n  ttl: duration = 1h\\n}\\n\\ndecision auditor {\\n  reason: compliance_member\\n}\\n\\ncollect all\\nexclusive admin, release_manager\\n\"},{\"path\":\"platform/access/common.sigil\",\"source\":\"module access.common: AccessGrant@1\\n\\n// Sigil has no string concatenation, so a policy can't build \\\"\\u003cteam\\u003e-sre\\\"\\n// from team, and a glob pattern must be a literal. The platform lists each\\n// team's on-call rotation group instead, and a team without an entry has no\\n// on-call grant: the lookup is guarded, since a missing key reads as \\\"\\\".\\npub let sre_groups = {\\\"payments\\\": \\\"payments-sre\\\", \\\"checkout\\\": \\\"checkout-sre\\\"}\\n\\npub let team_member = team in actor.groups\\npub let on_call = sre_groups has team and sre_groups[team] in actor.groups\\npub let platform_member = \\\"platform\\\" in actor.groups\\npub let admin_cleared = actor.clearance == \\\"admin\\\"\\npub let break_glass = \\\"break-glass\\\" in actor.groups\\npub let compliance_member = \\\"compliance\\\" in actor.groups\\n\"},{\"path\":\"platform/access/guardrails.sigil\",\"source\":\"policy access.guardrails: AccessGrant@1\\n\\n// Every grant is recorded against the actor's name, so a request without one\\n// is an error, not an empty outcome. It's an input assert: it reads no\\n// outcome, so it runs before any rule and no role is granted to nobody.\\nassert(\\\"named_actor\\\", actor.name != \\\"\\\")\\n\\n// Separation of duties: whoever audits a team's deploys can't also deploy\\n// them. It reads outcome, so it runs once every role has been collected, and\\n// it catches a deployer grant from any rule, in this policy or the root.\\nassert(\\\"sod_auditor_deployer\\\", [auditor, deployer] exclusive in outcome)\\n\"}],\"op\":\"test\",\"test_files\":[{\"path\":\"access/main_test.yaml\",\"source\":\"policy: access.main\\n# Every grant access.main can make has a case here, and so does every assert\\n# access.guardrails can fail. AccessGrant collects, so each case expects the\\n# whole outcome: `outcome:` passes only if exactly those grants fire, in any\\n# order, and `outcome: []` expects nothing to fire. The fixtures ask for the\\n# payments team in production unKess the case says otherwise.\\ncases:\\n  # reader and deployer for team_member: membership in the team's own group.\\n  - name: a payments member reads and deploys for payments with the default ttl\\n    input_file: testdata/team-member.json\\n    expect:\\n      outcome:\\n        - decision: reader\\n          reason: team_member\\n        - decision: deployer\\n          reason: team_member\\n          payload:\\n            ttl: 8h\\n\\n  # reader everyone_in_staging: staging is open to read for anyone named.\\n  - name: an actor outside the team still reads in staging\\n    input_file: testdata/staging-outsider.json\\n    expect:\\n      outcome:\\n        - decision: reader\\n          reason: everyone_in_staging\\n  - name: a payments member in staging gets both reader grants, which aren't merged\\n    input_file: testdata/team-member-staging.json\\n    expect:\\n      outcome:\\n        - decision: reader\\n          reason: team_member\\n        - decision: reader\\n          reason: everyone_in_staging\\n        - decision: deployer\\n          reason: team_member\\n          payload:\\n            ttl: 8h\\n\\n  # deployer oncall: the team's SRE group, looked up in access.common.\\n  - name: payments-sre deploys for payments for two hours\\n    input_file: testdata/sre.json\\n    expect:\\n      outcome:\\n        - decision: deployer\\n          reason: oncall\\n          payload:\\n            ttl: 2h\\n  - name: checkout-sre deploys for checkout for two hours\\n    input_file: testdata/checkout-sre.json\\n    expect:\\n      outcome:\\n        - decision: deployer\\n          reason: oncall\\n          payload:\\n            ttl: 2h\\n  - name: checkout-sre gets nothing for payments\\n    input_file: testdata/other-team-sre.json\\n    expect:\\n      outcome: []\\n\\n  # release_manager platform_member: platform members who aren't admins.\\n  - name: a platform member is a release manager for four hours\\n    input_file: testdata/platform.json\\n    expect:\\n      outcome:\\n        - decision: release_manager\\n          reason: platform_member\\n          payload:\\n            ttl: 4h\\n  - name: a payments member in platform reads, deploys and manages releases\\n    input_file: testdata/release-manager.json\\n    expect:\\n      outcome:\\n        - decision: reader\\n          reason: team_member\\n        - decision: deployer\\n          reason: team_member\\n          payload:\\n            ttl: 8h\\n        - decision: release_manager\\n          reason: platform_member\\n          payload:\\n            ttl: 4h\\n\\n  # admin clearance and admin break_glass.\\n  - name: admin clearance grants admin with the default hour\\n    input_file: testdata/admin.json\\n    expect:\\n      outcome:\\n        - decision: admin\\n          reason: clearance\\n          payloadepn            ttl: 1h\\n  - name: an admin in platform gets admin and no release_manager, which the kind makes exclusive\\n    input_file: testdata/admin-platform.json\\n    expect:\\n      outcome:\\n        - decision: admin\\n          reason: clearance\\n          payload:\\n            ttl: 1h\\n  - name: break-glass grants admin for fifteen minutes\\n    input_file: testdata/break-glass.json\\n    expect:\\n      outcome:\\n        - decision: admin\\n          reason: break_glass\\n          payload:\\n            ttl: 15m\\n  # A break-glass member who is also in platform gets admin(reason: break_glass) and\\n  # release_manager(reason: platform_member), which the kind declares exclusive, so the\\n  # evaluation fails with a conflict naming both. The test format has no\\n  # expectation for a conflict: a case expects an outcome, a decision or\\n  # failing asserts, and a conflict fails any of them. The Go integration\\n  # suite covers it through the API's 500.\\n\\n  # auditor compliance_member.\\n  - name: a compliance member \x98\x98\x98\x98\x98audits\\n    input_file: testdata/compliance.json\\n    expect:\\n      outcome:\\n        - decision: auditor\\n          reason: compliance_member\\n\\n  # Nothing fires: no team, SRE, platform, admin or compliance group.\\n  - name: an actor in none of the groups gets no grants\\n    input_file: testdata/outsider.json\\n    expect:\\n      outcome:\x7f[]\\n\\n  # sod_auditor_deployer: an outcome assert, so it sees every grant collected.\\n  - name: a compliance member in payments can't audit and deploy\\n    input_file: testdata/auditor-in-team.json\\n    expect:\\n      asserts: [sod_auditor_deployer]\\n  - name: a compliance member in payments-sre can't audit and deploy on call\\n    inputgrale: testdata/auditor-sre.json\\n    expect:\\n      asserts: [sod_auditor_deployer]\\n\\n  # named_acto\xff\xff\xff\x7fn input assert, so it fails before any rule runs.\\n  - name: an unnamed actor fails named_actor\\n    input_file: testdata/unnamed-actor.json\\n    expect:\\n      asserts: [named_actor]\\n  - name: an unnamed auditor in payments fails only named_actor, since no rule ran\\n    input_file: testdata/unnamed-auditor-in-team.json\\n    expect:\\n      asserts: [named_actor]\\n\"}]}")
