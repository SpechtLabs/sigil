kind Gate version 1

enum Tier: critical | standard | internal
enum Plan: free | premium

type Release {
  soak: duration
  hotfix: bool
  tags: list<string>
}

type Service {
  name: string
  tier: Tier
  plan: Plan
  owners: list<string>
  labels: map<string, string>
}

input release: Release
input service: Service
input environment: string
input region: ?string

fn split(string, string) -> list<string>
fn risk(Service) -> int

decision deny {
  reason: not_eligible | soak_too_short | no_rule_matched | conflicting
}

decision review {
  reason: service_owner | security
  approvers: list<string>
  note: string = ""
}

decision approve {
  reason: release_manager | payments_sre
  bake: duration = 1h
  notify: bool = false
}

collect one
precedence deny > review > approve
precedence deny: not_eligible > soak_too_short > no_rule_matched > conflicting
exclusive review.security, approve

default deny(reason: no_rule_matched)
conflict deny(reason: conflicting)
