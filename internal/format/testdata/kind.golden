kind DeployApproval version 3, accepts: 2

enum Tier: critical | standard
  | internal
enum Plan: free | pro
  | enterprise // the top plan

enum Region: eu

type Release {
  soak: duration
  hotfix: bool
  ticket: ?string
  tier: Tier
}

type Resource {
  kind: string // field named like a keyword
  policy: string
  labels: map<string, list<string>>
}

type Empty {}

input release: Release
input environment: string

fn split(string, string) -> list<string>
fn now() -> timestamp

decision deny {
  reason: not_eligible | soak_too_short
    | no_rule_matched
}

decision review {
  reason: service_owner
  approvers: list<string>
}

decision approve {
  // the approvers
  reason: release_manager
    | payments_sre
  bake: duration = 1h // how long
  note: string = ""
}

collect one
precedence deny > review > approve
precedence approve: release_manager > payments_sre
exclusive approve.release_manager, approve.payments_sre

default deny(reason: no_rule_matched)
conflict deny(
  reason: soak_too_short,
)
