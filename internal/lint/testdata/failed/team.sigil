policy team.broken: DeployApproval@1

// Fails to check, so its unused let isn't linted.
let unused = release.hotfix

when service.teir == "x" {
  approve(reason: payments_sre)
}

---

policy team.clean: DeployApproval@1

let unused = release.hotfix

when release.hotfix {
  approve(reason: payments_sre)
}
