kind DeployApproval version 2

enum Region: eu | us
enum Zone: eu | apac

type Service {
  tier: string
}

input service: Service
input approvers: list<string>
input region: Region

fn split(string, string) -> list<string>

decision deny {
  reason: no_rule_matched
}

decision escalate {
  reason: on_call
}

decision approve {
  reason: ok
}

collect one
precedence deny > escalate > approve

default deny(reason: no_rule_matched)
