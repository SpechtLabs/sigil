policy team.main: DeployApproval@1

// Whole import, read through its qualifier: used.
use deploy.common
// Whole import of a policy, invoked: used.
use deploy.production
// Selective import: owns is read, is_critical isn't.
use deploy.common.{owns, is_critical}
// Aliased item, never read.
use deploy.common.{hotfix as urgent}

production()

when common.hotfix and owns {
  approve(reason: payments_sre)
}
