== access/common.sigil ==
// Code generated by pkg/build from access_test.go. DO NOT EDIT.

module access.common: Access@2

// Who the actor is.
let owner_name = owners[service.name].name
pub let owner = owner_name == actor.name
pub let is_admin = actor.level == admin
pub let senior =
  size(actor.roles) >= 2
  and "guest" not in actor.roles
  and actor.roles[0] != "intern"
pub let sre = filter r in actor.roles: r like "sre-*"
pub let leads = ["lead", "staff"] one in actor.roles
pub let duties_split = ["approver", actor.name] exclusive in actor.roles

// The service.
// Its plan and class share the value standard.
pub let standard_plan = service.plan == Plan.standard
pub let important = service.class in [critical, Class.standard]
pub let managed = service.labels has {"managed-by": "argocd"}
pub let payments = "payments" in lower(service.name)
pub let has_quota = quotas has critical or quotas[service.class] > 0

// The change.
pub let signed = all c in commits: (c.signed and c.author != "")
pub let fresh = any c in commits: now - c.at < 2h
pub let reviewed = any r in reviews: (present r and r?.signed ?? false)
pub let in_window = between(now, commits[0].at, now + (change?.window ?? 30m))
pub let ticketed = present ticket and ticket ?? "" matches `^CHG-\d+$`
pub let approved =
  present change?.approver and change?.approver?.name ?? "" != actor.name
pub let base_signed = change?.base.signed ?? false
pub let scored = score + 0.5 > 1.0 xor -score < -2.5
pub let counted = count - 1 >= 0
pub let named = actor.name != ""
== access/guard.sigil ==
// Code generated by pkg/build from access_test.go. DO NOT EDIT.

policy access.guard: Access@2

use access.common.{owner, senior, signed}

param max_ttl: duration = 8h, min: 1h, max: 24h
param levels: list<Level> = [read, write]
param min_roles: int, min: 1

pub let unsigned = not signed

assert("score_range", score >= -10.0)

when unsigned {
  refuse(reason: unsigned)
}

when owner and signed {
  let oncall = any r in actor.roles: r like "oncall-*"

  // Owners get the level they hold.
  when actor.level in levels {
    grant(reason: owner, level: actor.level, ttl: max_ttl)
  }

  when oncall and size(actor.roles) >= min_roles {
    assert("oncall_is_senior", senior)
    grant(reason: oncall, level: read)
  }
}

assert("owner_needs_ticket", grant.owner not in outcome or present ticket)
== access/team.sigil ==
// Code generated by pkg/build from access_test.go. DO NOT EDIT.

policy access.team: Access@2

use access.baseline
use access.guard
use access.handwritten.{weekend}

param ttl: duration = 4h

guard(max_ttl: ttl, min_roles: 2)

when guard.unsigned {
  refuse(reason: frozen)
}

when weekend {
  baseline()
}
