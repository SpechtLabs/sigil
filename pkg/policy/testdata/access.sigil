// A collecting kind: every grant that fires applies, and an assert keeps
// two of them apart unless the actor is on call.
policy access.engineering: AccessGrant@1

when "engineering" in actor.teams {
  read("engineering_member")
}

when "platform" in actor.teams {
  write("platform_member")
  admin("platform_member", ttl: 1h)
}

when "oncall" in actor.roles {
  admin("oncall")
}

assert("sod_read_admin", [read, admin] exclusive in outcome or "oncall" in actor.roles)
