// The Compartments kind declares grant_a and grant_b exclusive: both
// firing is a conflict even though deny outranks them.
policy p: Compartments@1

when "a" in actor.teams {
  grant_a(reason: member)
}

when "b" in actor.teams {
  grant_b(reason: member)
}

when "suspended" in actor.roles {
  deny(reason: suspended)
}

assert("someone", actor.name != "")
