// A collect all kind with precedence returns every candidate at the top
// rank: every review when no deny fired, and nothing below it.
policy p: Reviews@1

when service.tier == "critical" {
  review(reason: security, approvers: ["security-leads"])
}

when "payments" in service.owners {
  review(reason: owner, approvers: ["payments-leads"])
}

when release.hotfix {
  approve(reason: hotfix)
}

when release.soak < 1h {
  deny(reason: soak_too_short)
}
