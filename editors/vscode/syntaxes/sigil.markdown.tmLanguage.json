{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Highlights ```sigil fences in Markdown with the Sigil grammar.",
  "scopeName": "markdown.sigil.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "fileTypes": [],
  "patterns": [{ "include": "#sigil-code-block" }],
  "repository": {
    "sigil-code-block": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(sigil)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.sigil",
          "patterns": [{ "include": "source.sigil" }]
        }
      ]
    }
  }
}
