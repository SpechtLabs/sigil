kind Access version 1

type User {
  name: string
  teams: list<string>
  admin: bool
  expires: ?timestamp
}

input user: User
input resource: string
input age: duration
input labels: map<string, int>

fn owner(string) -> string

decision deny {
  reason: banned | too_old | no_rule_matched
}

decision allow {
  reason: admin | team_member
  ttl: duration = 1h
  scopes: list<string> = []
}

collect one
precedence deny > allow
precedence allow: admin > team_member

default deny(reason: no_rule_matched)
