{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sigil",
      "camelcase": "Sigil",
      "title": "Sigil",
      "scope": "source.sigil",
      "path": ".",
      "file-types": [
        "sigil"
      ],
      "injection-regex": "^sigil$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm",
      "class-name": "TreeSitterSigil"
    }
  ],
  "metadata": {
    "version": "0.8.0",
    "license": "Apache-2.0",
    "description": "Sigil policy, module and kind files for tree-sitter",
    "authors": [
      {
        "name": "Cedric Specht",
        "email": "cedric@specht-labs.de"
      }
    ],
    "links": {
      "repository": "https://github.com/SpechtLabs/sigil",
      "homepage": "https://sigil.specht-labs.de"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
