policy deploy: Approval@1

let manager_approvals = ["cedric", "alice", "bob"]

when "manager" in requestor.roles
  and target.labels["env"] == "prod" {
  approve(reason: prod_user, how_long: 1h)
}

when "user" in requestor.roles
  and target.labels["env"] == "prod" {
  review(reason: manager_approval, approvers: remove_requestor(requestor, manager_approvals))
}

when target.labels["env"] == "test" {
  approve(reason: we_dont_care, how_long: 4h)
}

when "foo" in requestor.roles {
  deny(reason: not_eligible)
}
